# EzAllow — copiar a `.env` en la raíz (y/o apps según necesites)

# API
PORT=3001
NODE_ENV=development

# Mongo — local o Atlas. DB de desarrollo EzAllow: DBEZALLOW
# (no commitear credenciales; copiar a `.env`)
MONGODB_URI=mongodb://127.0.0.1:27017/DBEZALLOW
# Atlas ejemplo (reemplazar user/pass/hosts):
# MONGODB_URI=mongodb://USER:PASS@host1:27017,host2:27017,host3:27017/DBEZALLOW?ssl=true&replicaSet=...&authSource=admin&retryWrites=true&w=majority

# SOCKS5 (ej. ssh -N -D 1080 dgartech) — dejar vacío si no aplica
MONGODB_PROXY_HOST=127.0.0.1
MONGODB_PROXY_PORT=1080

# Web — vacío / omitir = proxy same-origin `/backend` → Nest (recomendado)
# NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://127.0.0.1:3001
NEXT_PUBLIC_TENANT_ID=blinka-demo

# Deploy público temporal en dgartech.com (ver docs/DEPLOY-DGARTECH.md)
# Local: dejar vacío. Prod: /30x-EzAllow
# NEXT_PUBLIC_BASE_PATH=/30x-EzAllow
# En servidor: API_INTERNAL_URL=http://127.0.0.1:3011  · web :3010 · api :3011


# Tenant demo (header x-tenant-id)
DEFAULT_TENANT_ID=blinka-demo

# Feature flags (F2+)
EXTRACTOR=fixture
EXECUTOR=mock
JUDGMENT=noop

# LLM opcional (F2.4) — vacío = no LLM
# OPENAI_API_KEY=
